SITE_URL=http://localhost:3000
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio
# Set this to Neon's direct (non-pooler) URL in Vercel. Local development may leave it empty.
DATABASE_URL_UNPOOLED=
PAYLOAD_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Docker enables this automatically. Keep it false or empty for Vercel.
PAYLOAD_MIGRATE_ON_START=

# Leave all R2 values empty for persistent local media, or configure all five for R2 storage.
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_PUBLIC_URL=
# Optional. Vercel previews receive an isolated prefix automatically when this is empty.
R2_PREFIX=
